                                <i data-lucide="compass" className="w-5 h-5"></i> Pramuka & Ekstrakurikuler
                            </h3>
                            <p className="text-xs text-slate-600 leading-relaxed">
                                Kegiatan Praja Muda Karana sebagai pembentukan kedisiplinan serta ekstrakurikuler seni Hadrah, Kaligrafi, Olahraga, dan English Club.
                            </p>
                        </div>
                    </div>
                </div>
            );
        }

        // 6. BERITA SECTION
        function BeritaSection({ berita, setSelectedNews }) {
            return (
                <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
                    <div className="text-center max-w-xl mx-auto">
                        <h2 className="text-3xl font-extrabold text-slate-900 font-serif">Berita & Publikasi</h2>
                        <p className="text-xs text-slate-500">Kumpulan artikel dan pengumuman MTs Almas'udiyah</p>
                    </div>

                    <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                        {berita.map((item) => (
                            <div key={item.id} className="bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-100 flex flex-col">
                                <img src={item.image} alt={item.title} className="h-48 w-full object-cover" />
                                <div className="p-5 flex-grow flex flex-col justify-between space-y-3">
                                    <div>
                                        <span className="text-[10px] font-bold px-2 py-0.5 bg-emerald-100 text-brand-green rounded uppercase">{item.category}</span>
                                        <h3 className="font-bold text-base text-slate-900 mt-2">{item.title}</h3>
                                        <p className="text-xs text-slate-600 mt-2">{item.summary}</p>
                                    </div>
                                    <button onClick={() => setSelectedNews(item)} className="text-xs font-bold text-brand-green hover:underline text-left">
                                        Selengkapnya →
                                    </button>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            );
        }

        // 7. GALERI SECTION
        function GaleriSection({ gallery, setSelectedImage }) {
            return (
                <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
                    <div className="text-center max-w-xl mx-auto">
                        <h2 className="text-3xl font-extrabold text-slate-900 font-serif">Galeri Foto</h2>
                        <p className="text-xs text-slate-500">Klik gambar untuk melihat tampilan penuh</p>
                    </div>

                    <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                        {gallery.map((img) => (
                            <div 
                                key={img.id} 
                                onClick={() => setSelectedImage(img)}
                                className="group bg-white rounded-2xl overflow-hidden shadow-sm border border-slate-100 cursor-pointer"
                            >
                                <img src={img.src} alt={img.title} className="h-56 w-full object-cover group-hover:scale-105 transition duration-300" />
                                <div className="p-4">
                                    <span className="text-[10px] font-bold px-2 py-0.5 bg-amber-100 text-amber-800 rounded">{img.category}</span>
                                    <h4 className="font-bold text-sm text-slate-900 mt-1">{img.title}</h4>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            );
        }

        // 8. INFORMASI SPMB SECTION
        function SPMBSection({ profile }) {
            return (
                <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
                    <div className="bg-gradient-to-r from-brand-green to-emerald-800 text-white p-8 sm:p-12 rounded-3xl shadow-xl text-center space-y-4">
                        <span className="bg-amber-400 text-slate-900 font-extrabold text-xs px-3 py-1 rounded-full uppercase">Penerimaan Murid Baru</span>
                        <h2 className="text-3xl sm:text-4xl font-extrabold font-serif">Pendaftaran Siswa Baru (SPMB)</h2>
                        <p className="text-sm text-slate-200 max-w-xl mx-auto">
                            Bergabunglah bersama keluarga besar MTs Almas'udiyah Pramian Taman Sreseh Sampang.
                        </p>
                        <div className="pt-4 flex flex-wrap justify-center gap-4">
                            <a 
                                href={`https://wa.me/${profile.phone1.replace(/[^0-9]/g, '')}?text=Halo%20Panitia%20SPMB%20MTs%20Almas'udiyah`}
                                target="_blank"
                                rel="noopener noreferrer"
                                className="bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold px-6 py-3 rounded-xl text-sm flex items-center gap-2"
                            >
                                <i data-lucide="phone-call" className="w-4 h-4"></i> WhatsApp Panitia 1 ({profile.phone1})
                            </a>
                            <a 
                                href={`https://wa.me/${profile.phone2.replace(/[^0-9]/g, '')}?text=Halo%20Panitia%20SPMB%20MTs%20Almas'udiyah`}
                                target="_blank"
                                rel="noopener noreferrer"
                                className="bg-white/20 hover:bg-white/30 text-white font-bold px-6 py-3 rounded-xl text-sm flex items-center gap-2 border border-white/30"
                            >
                                WhatsApp Panitia 2 ({profile.phone2})
                            </a>
                        </div>
                    </div>

                    <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div className="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm space-y-4">
                            <h3 className="text-xl font-bold text-slate-900 border-b pb-2">Persyaratan Pendaftaran</h3>
                            <ul className="space-y-3 text-xs sm:text-sm text-slate-700 list-disc list-inside">
                                <li>Mengisi Formulir Pendaftaran (Offline / Online).</li>
                                <li>Fotokopi Ijazah SD/MI / Surat Keterangan Lulus (SKL) 2 Lembar.</li>
                                <li>Fotokopi Kartu Keluarga (KK) & Akta Kelahiran 2 Lembar.</li>
                                <li>Pas Foto Terbaru Ukuran 3x4 (3 Lembar).</li>
                                <li>Fotokopi KIP/PKH (Jika Ada).</li>
                            </ul>
                        </div>

                        <div className="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm space-y-4">
                            <h3 className="text-xl font-bold text-slate-900 border-b pb-2">Alur & Lokasi Pendaftaran</h3>
                            <div className="space-y-3 text-xs sm:text-sm text-slate-700">
                                <p><strong>Pendaftaran Offline:</strong> Datang langsung ke Sekretariat Panitia SPMB di Gedung MTs Almas'udiyah, Jalan KH. Abd. Qahir Pramian Taman Sreseh Sampang.</p>
                                <p><strong>Jam Layanan:</strong> Setiap Hari Kerja (07.30 - 12.00 WIB)</p>
                                <p className="text-brand-green font-semibold">Bebas Biaya Formulir Pendaftaran.</p>
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        // 9. KONTAK SECTION
        function KontakSection({ profile }) {
            const [submitted, setSubmitted] = useState(false);

            const handleSubmit = (e) => {
                e.preventDefault();
                setSubmitted(true);
                setTimeout(() => setSubmitted(false), 4000);
            };

            return (
                <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
                    <div className="text-center max-w-xl mx-auto">
                        <h2 className="text-3xl font-extrabold text-slate-900 font-serif">Hubungi Kami</h2>
                        <p className="text-xs text-slate-500">Pusat Informasi & Layanan MTs Almas'udiyah</p>
                    </div>

                    <div className="grid grid-cols-1 md:grid-cols-12 gap-8">
                        <div className="md:col-span-5 bg-white p-8 rounded-3xl border border-slate-100 shadow-sm space-y-6">
                            <h3 className="font-bold text-lg text-slate-900 border-b pb-2">Informasi Kontak</h3>
                            <div className="space-y-4 text-xs sm:text-sm text-slate-700">
                                <div>
                                    <span className="font-bold text-slate-900 block">Alamat Resmi:</span>
                                    <p>{profile.address}, {profile.village}, {profile.subdistrict}, {profile.city} ({profile.postalCode})</p>
                                </div>
                                <div>
                                    <span className="font-bold text-slate-900 block">Telepon / WhatsApp:</span>
                                    <p>{profile.phone1}</p>
                                    <p>{profile.phone2}</p>
                                    <p>{profile.phone3}</p>
                                </div>
                                <div>
                                    <span className="font-bold text-slate-900 block">Email Resmi:</span>
                                    <p>{profile.email}</p>
                                </div>
                            </div>
                        </div>

                        <div className="md:col-span-7 bg-white p-8 rounded-3xl border border-slate-100 shadow-sm">
                            <h3 className="font-bold text-lg text-slate-900 mb-4">Kirim Pesan</h3>
                            {submitted && (
                                <div className="mb-4 p-3 bg-emerald-100 text-brand-green rounded-xl text-xs font-semibold">
                                    Pesan Anda telah berhasil dikirim! Panitia akan merespons secepatnya.
                                </div>
                            )}
                            <form onSubmit={handleSubmit} className="space-y-4 text-xs sm:text-sm">
                                <div>
                                    <label className="block font-medium text-slate-700 mb-1">Nama Lengkap</label>
                                    <input type="text" required className="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-brand-green" placeholder="Masukkan nama..." />
                                </div>
                                <div>
                                    <label className="block font-medium text-slate-700 mb-1">Nomor WhatsApp</label>
                                    <input type="text" required className="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-brand-green" placeholder="08xxx..." />
                                </div>
                                <div>
                                    <label className="block font-medium text-slate-700 mb-1">Pesan / Pertanyaan</label>
                                    <textarea rows="4" required className="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-brand-green" placeholder="Tuliskan pesan Anda..."></textarea>
                                </div>
                                <button type="submit" className="w-full bg-brand-green hover:bg-emerald-700 text-amber-300 font-bold py-3 rounded-xl shadow transition">
                                    Kirim Pesan
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            );
        }

        // 10. ADMIN DASHBOARD
        function AdminDashboard({ data, updateProfileField, updateStatsField, setData, loggedIn, handleLogin, adminPass, setAdminPass, adminError, setAdminLoggedIn }) {
            if (!loggedIn) {
                return (
                    <div className="max-w-md mx-auto my-20 p-8 bg-white rounded-3xl shadow-xl border border-slate-100 space-y-6">
                        <div className="text-center">
                            <div className="w-12 h-12 bg-amber-100 text-amber-700 rounded-full flex items-center justify-center mx-auto mb-2">
                                <i data-lucide="lock" className="w-6 h-6"></i>
                            </div>
                            <h2 className="text-2xl font-bold text-slate-900">Login Administrator</h2>
                            <p className="text-xs text-slate-500">Panel Kelola Konten Website MTs Almas'udiyah</p>
                        </div>
                        {adminError && <div className="p-3 bg-red-100 text-red-700 rounded-xl text-xs">{adminError}</div>}
                        <form onSubmit={handleLogin} className="space-y-4">
                            <div>
                                <label className="block text-xs font-semibold text-slate-700 mb-1">Password Admin</label>
                                <input 
                                    type="password" 
                                    value={adminPass}
                                    onChange={(e) => setAdminPass(e.target.value)}
                                    placeholder="Masukkan password (demo: admin123)"
                                    className="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-brand-green" 
                                />
                            </div>
                            <button type="submit" className="w-full bg-brand-green text-amber-300 font-bold py-2.5 rounded-xl text-sm shadow hover:bg-emerald-700 transition">
                                Masuk Dashboard
                            </button>
                        </form>
                    </div>
                );
            }

            return (
                <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
                    <div className="flex justify-between items-center bg-white p-6 rounded-2xl border border-slate-100 shadow-sm">
                        <div>
                            <span className="text-xs font-bold text-amber-600 bg-amber-50 px-2.5 py-1 rounded">Status: Admin Login</span>
                            <h2 className="text-2xl font-extrabold text-slate-900 mt-1">Dashboard Pengelolaan Website</h2>
                        </div>
                        <button onClick={() => setAdminLoggedIn(false)} className="bg-red-50 text-red-600 hover:bg-red-100 font-bold text-xs px-4 py-2 rounded-xl transition">
                            Keluar Admin
                        </button>
                    </div>

                    {/* Edit Profil Utama */}
                    <div className="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm space-y-4">
                        <h3 className="font-bold text-slate-900 border-b pb-2">Edit Identitas & Profil Sekolah</h3>
                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
                            <div>
                                <label className="block text-slate-600 mb-1">Nama Madrasah</label>
                                <input type="text" value={data.profile.name} onChange={(e) => updateProfileField('name', e.target.value)} className="w-full p-2 border rounded-lg" />
                            </div>
                            <div>
                                <label className="block text-slate-600 mb-1">Kepala Madrasah</label>
                                <input type="text" value={data.profile.headmaster} onChange={(e) => updateProfileField('headmaster', e.target.value)} className="w-full p-2 border rounded-lg" />
                            </div>
                            <div>
                                <label className="block text-slate-600 mb-1">Slogan Utama</label>
                                <input type="text" value={data.profile.slogan} onChange={(e) => updateProfileField('slogan', e.target.value)} className="w-full p-2 border rounded-lg" />
                            </div>
                            <div>
                                <label className="block text-slate-600 mb-1">Nomor Kontak SPMB 1</label>
                                <input type="text" value={data.profile.phone1} onChange={(e) => updateProfileField('phone1', e.target.value)} className="w-full p-2 border rounded-lg" />
                            </div>
                        </div>
                    </div>

                    {/* Edit Statistik */}
                    <div className="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm space-y-4">
                        <h3 className="font-bold text-slate-900 border-b pb-2">Edit Statistik Sekolah</h3>
                        <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
                            <div>
                                <label className="block text-slate-600 mb-1">Jumlah Siswa</label>
                                <input type="number" value={data.stats.students} onChange={(e) => updateStatsField('students', e.target.value)} className="w-full p-2 border rounded-lg" />
                            </div>
                            <div>
                                <label className="block text-slate-600 mb-1">Jumlah Guru</label>
                                <input type="number" value={data.stats.teachers} onChange={(e) => updateStatsField('teachers', e.target.value)} className="w-full p-2 border rounded-lg" />
                            </div>
                            <div>
                                <label className="block text-slate-600 mb-1">Rombongan Belajar</label>
                                <input type="number" value={data.stats.classes} onChange={(e) => updateStatsField('classes', e.target.value)} className="w-full p-2 border rounded-lg" />
                            </div>
                            <div>
                                <label className="block text-slate-600 mb-1">Jumlah Prestasi</label>
                                <input type="number" value={data.stats.achievements} onChange={(e) => updateStatsField('achievements', e.target.value)} className="w-full p-2 border rounded-lg" />
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        // Render React App
        ReactDOM.createRoot(document.getElementById('root')).render(<App />);
    </script>
</body>
</html>
